classDiagram
    class Owner {
        +String name
        +int available_minutes
        +List~Pet~ pets
        +add_pet(pet: Pet)
    }

    class Pet {
        +String name
        +String species
        +String breed
        +int age
        +List~Task~ tasks
        +add_task(task: Task)
    }

    class Task {
        +String name
        +String category
        +int duration_minutes
        +int daily_frequency
        +int priority
        +String pet_name
        +String time
        +String recurrence
        +date due_date
        +bool completed
        +mark_complete()
    }

    class Scheduler {
        +Owner owner
        +List~Task~ scheduled_tasks
        +generate_plan() List~Task~
        +filter_by_priority() List~Task~
        +sort_by_time(tasks: List~Task~) List~Task~
        +detect_time_conflicts(tasks) List~ConflictPair~
        +get_conflict_warnings(tasks) List~String~
        +generate_plan_with_warnings() PlanWithWarnings
        +mark_task_complete(task: Task) Task
        +fits_in_time(task: Task, time_used: int) bool
        +explain_plan() String
    }

    Owner "1" --> "0..*" Pet : owns
    Pet "1" --> "0..*" Task : has
    Scheduler "1" --> "1" Owner : plans for
    Scheduler ..> Task : schedules/checks